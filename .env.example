# Earthdata Login App Credentials
EARTHDATA_CLIENT_ID=your_client_id_here
EARTHDATA_CLIENT_SECRET=your_client_secret_here
EARTHDATA_SERVER_URL=https://urs.earthdata.nasa.gov

# Public URL of this MCP server (required by Skybridge resourceServerUrl)
SERVER_URL=http://localhost:3000

#AUTH_TOKEN="YOUR_EARTHDATA_LOGIN_TOKEN_HERE" # FOR LOCAL DEVELOPMENT ONLY, turns off OAuth

# Enable developer/demo hardcoded features (e.g. Jamaica wind speed demo overrides)
ENABLE_DEV_FEATURES=false
