# Earthdata Login App Credentials
EARTHDATA_CLIENT_ID=your_client_id_here
EARTHDATA_CLIENT_SECRET=your_client_secret_here

# Earthdata Login Server URL
# - UAT (Default for testing): https://uat.urs.earthdata.nasa.gov
# - Production: https://urs.earthdata.nasa.gov
EARTHDATA_SERVER_URL=https://uat.urs.earthdata.nasa.gov

# Public URL of this MCP server (required by Skybridge resourceServerUrl)
SERVER_URL=http://localhost:3000
